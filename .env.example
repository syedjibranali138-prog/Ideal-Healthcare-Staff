# Ideal Healthcare Staffing - Environment Variables Template
# Copy this file to .env.local and update with your actual credentials.

# Supabase Configuration (Database & Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose

# Admin Portal Authentication
ADMIN_EMAIL=admin@idealhealthcarestaffing.com
ADMIN_PASSWORD=change-to-a-secure-password
ADMIN_SECRET_TOKEN=generate-a-random-secure-secret-token

# Email Provider Configuration (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key
FROM_EMAIL=notifications@idealhealthcarestaffing.com
ADMIN_NOTIFICATION_EMAIL=leads@idealhealthcarestaffing.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
